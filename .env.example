# Copia a .env (local) y define las mismas variables en Cloudflare Pages / Vercel.
# ID de editor de AdSense (ej. ca-pub-1234567890123456). Vacío = no se carga nada de AdSense.
PUBLIC_ADSENSE_CLIENT=
# Endpoint del formulario de contacto (Formspree, Web3Forms, etc.)
PUBLIC_FORM_ENDPOINT=https://formspree.io/f/TU_ID
