---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { eur, num, consumo100, gapWltp } from '../lib/format';
const coches = (await getCollection('coches')).sort((a, b) => b.data.realAutonomyKm - a.data.realAutonomyKm);
---
<Layout title="Comparativa de coches eléctricos: autonomía real vs WLTP" description="Tabla comparativa de coches eléctricos en España: precio, batería, autonomía WLTP y real, consumo y coste de carga en casa.">
  <div class="contenedor py-10">
    <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white sm:text-4xl glow-text">Comparativa de coches eléctricos</h1>
    <p class="mt-2 max-w-2xl text-gray-400">Ordenados por autonomía real. La diferencia con WLTP muestra cuánto se aleja la cifra oficial del uso cotidiano. <a class="font-medium text-cyan-400 underline underline-offset-2" href="/metodologia/">Ver metodología</a>.</p>

    <div class="mt-8 overflow-x-auto rounded-2xl border border-white/10 bg-white/5 backdrop-blur-xl" tabindex="0" role="region" aria-label="Tabla comparativa, desplazable horizontalmente">
      <table class="w-full min-w-[720px] text-left text-sm text-gray-300">
        <caption class="sr-only">Comparativa de autonomía y coste de carga</caption>
        <thead class="bg-white/5 border-b border-white/10">
          <tr>
            <th scope="col" class="px-4 py-3 text-gray-400 font-semibold">Modelo</th><th scope="col" class="px-4 py-3 text-gray-400 font-semibold">Precio</th><th scope="col" class="px-4 py-3 text-gray-400 font-semibold">Batería</th>
            <th scope="col" class="px-4 py-3 text-gray-400 font-semibold">WLTP</th><th scope="col" class="px-4 py-3 text-gray-400 font-semibold">Real</th><th scope="col" class="px-4 py-3 text-gray-400 font-semibold">Diferencia</th>
            <th scope="col" class="px-4 py-3 text-gray-400 font-semibold">Consumo real</th><th scope="col" class="px-4 py-3 text-gray-400 font-semibold">Carga en casa / 100 km</th>
          </tr>
        </thead>
        <tbody>
          {coches.map((c) => (
            <tr class="border-t border-white/10 hover:bg-white/5 transition-colors">
              <th scope="row" class="px-4 py-3 font-semibold"><a class="text-cyan-400 underline underline-offset-2" href={`/coches/${c.slug}/`}>{c.data.brand} {c.data.title}</a></th>
              <td class="px-4 py-3 tabular-nums">{eur(c.data.priceCash).replace(',00', '')}</td>
              <td class="px-4 py-3 tabular-nums">{num(c.data.batteryKwh, 1)} kWh</td>
              <td class="px-4 py-3 tabular-nums">{num(c.data.wltpKm)} km</td>
              <td class="px-4 py-3 font-bold tabular-nums">{num(c.data.realAutonomyKm)} km</td>
              <td class="px-4 py-3 tabular-nums">−{gapWltp(c.data.wltpKm, c.data.realAutonomyKm)} %</td>
              <td class="px-4 py-3 tabular-nums">{num(consumo100(c.data.batteryKwh, c.data.realAutonomyKm), 1)} kWh</td>
              <td class="px-4 py-3 font-bold tabular-nums text-green-400">{num(c.data.chargingCostHome, 2)} €</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</Layout>
