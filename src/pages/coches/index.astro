---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CocheCard from '../../components/CocheCard.astro';
const coches = (await getCollection('coches')).sort((a, b) => a.data.priceCash - b.data.priceCash);
---
<Layout title="Coches eléctricos en España: precio, autonomía real y coste de carga" description="Catálogo de coches eléctricos con precio, autonomía real frente a WLTP y coste de carga por cada 100 km.">
  <div class="contenedor py-10">
    <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white sm:text-4xl glow-text">Coches eléctricos</h1>
    <p class="mt-2 max-w-2xl text-gray-400">Precio, autonomía real y coste de carga en casa. Consulta cómo calculamos los datos en la <a class="font-medium text-cyan-400 underline underline-offset-2" href="/metodologia/">metodología</a>.</p>

    <form role="search" class="mt-6 max-w-md" onsubmit="return false">
      <label for="filtro" class="etiqueta">Filtrar por marca o modelo</label>
      <input id="filtro" type="search" class="campo" autocomplete="off" />
    </form>
    <p id="vacio" class="mt-6 font-medium text-gray-300" role="status" hidden>No hay modelos que coincidan con tu búsqueda.</p>

    <div id="lista" class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {coches.map((c) => <CocheCard coche={c} />)}
    </div>
  </div>
</Layout>

<script>
  const input = document.getElementById('filtro') as HTMLInputElement;
  const vacio = document.getElementById('vacio')!;
  const cards = [...document.querySelectorAll<HTMLElement>('#lista [data-search]')];
  function filtrar() {
    const q = input.value.trim().toLowerCase();
    let n = 0;
    cards.forEach((c) => { 
      const ok = c.dataset.search!.includes(q); 
      c.style.display = ok ? '' : 'none'; 
      if (ok) n++; 
    });
    vacio.hidden = n > 0;
  }
  input.value = new URLSearchParams(location.search).get('q') ?? '';
  input.addEventListener('input', filtrar);
  filtrar();
</script>
