---
// src/pages/index.astro
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CalculadoraCarga from '../components/CalculadoraCarga.astro';
import CocheCard from '../components/CocheCard.astro';
import { fechaLarga } from '../lib/format';

const destacados = (await getCollection('coches')).slice(0, 3);
const guias = (await getCollection('guias')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---
<Layout title="EV España: coches eléctricos, autonomía real y coste de carga" description="Coches eléctricos, precios, autonomía real y coste de carga en España. Calculadora de recarga, comparativas y guías con metodología abierta.">
  <section class="bg-carbon text-white">
    <div class="contenedor py-16 sm:py-24">
      <h1 class="max-w-3xl text-4xl font-extrabold tracking-tight sm:text-6xl">El lado eléctrico de España</h1>
      <p class="mt-4 max-w-2xl text-lg text-gray-300">Coches eléctricos, precios, autonomía y números reales.</p>

      <form action="/coches/" method="get" role="search" class="mt-8 flex max-w-xl flex-col gap-3 sm:flex-row">
        <label for="buscar" class="sr-only">Buscar un modelo</label>
        <input id="buscar" name="q" type="search" placeholder="Busca un modelo: Renault 5, Dolphin…" autocomplete="off" class="campo flex-1 border-transparent" />
        <button type="submit" class="btn-primario">Buscar modelo</button>
      </form>
    </div>
  </section>

  <section class="contenedor -mt-8 mb-16 sm:-mt-10" aria-label="Calculadora">
    <CalculadoraCarga />
  </section>

  <section class="contenedor mb-16" aria-labelledby="destacados">
    <div class="mb-6 flex items-end justify-between gap-4">
      <h2 id="destacados" class="text-2xl font-bold sm:text-3xl">Modelos destacados</h2>
      <a href="/coches/" class="text-sm font-semibold text-primario underline underline-offset-2">Ver todos los coches</a>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {destacados.map((c) => <CocheCard coche={c} />)}
    </div>
  </section>

  <section class="bg-neutro py-14" aria-labelledby="guias">
    <div class="contenedor">
      <h2 id="guias" class="mb-6 text-2xl font-bold sm:text-3xl">Guías destacadas</h2>
      <div class="grid gap-6 md:grid-cols-3">
        {guias.map((g) => (
          <article class="flex flex-col rounded-2xl border border-gray-300 bg-white p-5">
            <p class="text-sm font-semibold text-primario">{g.data.category}</p>
            <h3 class="mt-1 text-lg font-bold">{g.data.title}</h3>
            <p class="mt-2 flex-1 text-sm text-gray-700">{g.data.description}</p>
            <p class="mt-3 text-xs text-gray-600"><time datetime={g.data.pubDate.toISOString()}>{fechaLarga(g.data.pubDate)}</time></p>
            <a href={`/guias/${g.slug}/`} class="btn-primario mt-4" aria-label={`Leer la guía: ${g.data.title}`}>Leer guía</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
