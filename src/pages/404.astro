---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Página no encontrada" description="La página que buscas no existe o se ha movido." noindex>
  <div class="contenedor py-20 text-center">
    <h1 class="text-4xl font-extrabold">Página no encontrada</h1>
    <p class="mx-auto mt-3 max-w-md text-gray-700">Puede que el enlace haya cambiado. Prueba con uno de estos accesos:</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a class="btn-primario" href="/">Ir al inicio</a>
      <a class="btn-secundario" href="/coches/">Ver coches</a>
      <a class="btn-secundario" href="/guias/">Ver guías</a>
    </div>
  </div>
</Layout>
