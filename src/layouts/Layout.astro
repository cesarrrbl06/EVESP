---
// src/layouts/Layout.astro — layout global: SEO, JSON-LD, AdSense, header y footer
import '@fontsource-variable/inter';
import '../styles/global.css';
import { SITE, NAV } from '../config/site';

export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: Date;
  jsonLd?: Record<string, unknown>[]; // entradas extra para el @graph (Article, Breadcrumb…)
}

const { title, description, image = '/og-default.png', type = 'website', noindex = false, publishedTime, jsonLd = [] } = Astro.props;
const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
const isHome = Astro.url.pathname === '/';
const fullTitle = isHome ? title : `${title} | ${SITE.name}`;
const path = Astro.url.pathname;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite', '@id': `${SITE.url}/#website`, url: `${SITE.url}/`, name: SITE.name, inLanguage: 'es-ES',
      publisher: { '@id': `${SITE.url}/#organization` },
      potentialAction: { '@type': 'SearchAction', target: `${SITE.url}/coches/?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
    },
    {
      '@type': 'Organization', '@id': `${SITE.url}/#organization`, name: SITE.name, url: `${SITE.url}/`,
      logo: `${SITE.url}/favicon.svg`, email: SITE.email,
    },
    ...jsonLd,
  ],
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#2563EB" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD: WebSite + Organization (+ extras por página) -->
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    <!--
      ===== GOOGLE ADSENSE (espacio reservado) =====
      1) Define PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX en Cloudflare/Vercel.
      2) El meta de abajo permite verificar el sitio; el script se carga de forma DIFERIDA
         (tras la primera interacción) para no penalizar Lighthouse.
      3) En el EEE/Reino Unido necesitas un CMP certificado por Google (TCF) ANTES de cargar
         anuncios: enlaza aquí su script y llama a load() solo tras el consentimiento.
      Snippet estándar (por si prefieres carga directa):
      <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX" crossorigin="anonymous"></script>
    -->
    {SITE.adsenseClient && <meta name="google-adsense-account" content={SITE.adsenseClient} />}
    {SITE.adsenseClient && (
      <script is:inline define:vars={{ client: SITE.adsenseClient }}>
        (function () {
          var done = false;
          function load() {
            if (done) return; done = true;
            var s = document.createElement('script');
            s.async = true; s.crossOrigin = 'anonymous';
            s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + client;
            document.head.appendChild(s);
          }
          ['scroll', 'pointerdown', 'keydown', 'touchstart'].forEach(function (e) {
            addEventListener(e, load, { once: true, passive: true });
          });
        })();
      </script>
    )}
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:font-semibold focus:text-carbon">Saltar al contenido</a>

    <header class="sticky top-0 z-40 border-b border-white/10 bg-black/60 backdrop-blur-xl">
      <div class="contenedor flex h-16 items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-3" aria-label="EV España, inicio">
          <img src="/img/logo.jpg" alt="Logo EV España" class="h-10 w-auto object-contain rounded" />
          <span class="text-xl font-bold tracking-tight text-white glow-text">EV España</span>
        </a>

        <nav aria-label="Principal" class="hidden items-center gap-1 md:flex">
          {NAV.map((i) => (
            <a href={i.href} aria-current={path.startsWith(i.href) ? 'page' : undefined}
               class="rounded-lg px-3 py-2 text-sm font-medium text-gray-300 hover:bg-white/10 hover:text-white aria-[current=page]:text-cyan-400 aria-[current=page]:glow-text transition-all">{i.label}</a>
          ))}
          <a href="/calculadoras/" class="btn-primario ml-2 border-cyan-500/50 shadow-[0_0_15px_rgba(0,240,255,0.3)]">Calcular carga</a>
        </nav>

        <!-- Menú móvil sin JavaScript (details/summary) -->
        <details class="group relative md:hidden">
          <summary class="flex min-h-[44px] min-w-[44px] cursor-pointer list-none items-center justify-center rounded-lg border border-gray-500 px-3 text-sm font-semibold [&::-webkit-details-marker]:hidden">
            Menú
          </summary>
          <nav aria-label="Principal móvil" class="absolute right-0 mt-2 w-64 rounded-xl border border-gray-200 bg-white p-2 shadow-lg">
            {NAV.map((i) => (
              <a href={i.href} class="block rounded-lg px-3 py-3 text-base font-medium text-carbon hover:bg-neutro">{i.label}</a>
            ))}
            <a href="/calculadoras/" class="btn-primario mt-2 w-full">Calcular carga</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="contenido" class="flex-1">
      <slot />
    </main>

    <!-- Footer obligatorio para AdSense: enlaces reales a las páginas legales -->
    <footer class="mt-16 bg-carbon text-gray-300">
      <div class="contenedor grid gap-8 py-12 sm:grid-cols-3">
        <div>
          <p class="text-lg font-bold text-white">EV España</p>
          <p class="mt-2 max-w-xs text-sm">Coches eléctricos, consumos reales y costes de carga en España, con método y datos abiertos.</p>
        </div>
        <nav aria-label="Explora">
          <p class="font-semibold text-white">Explora</p>
          <ul class="mt-3 space-y-2 text-sm">
            {NAV.map((i) => <li><a class="underline-offset-2 hover:text-white hover:underline" href={i.href}>{i.label}</a></li>)}
            <li><a class="underline-offset-2 hover:text-white hover:underline" href="/metodologia/">Metodología</a></li>
          </ul>
        </nav>
        <nav aria-label="Información legal">
          <p class="font-semibold text-white">Legal</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a class="underline-offset-2 hover:text-white hover:underline" href="/aviso-legal/">Aviso legal</a></li>
            <li><a class="underline-offset-2 hover:text-white hover:underline" href="/politica-de-privacidad/">Política de privacidad</a></li>
            <li><a class="underline-offset-2 hover:text-white hover:underline" href="/politica-de-cookies/">Política de cookies</a></li>
            <li><a class="underline-offset-2 hover:text-white hover:underline" href="/contacto/">Contacto</a></li>
          </ul>
        </nav>
      </div>
      <div class="border-t border-gray-700 py-4 text-center text-xs text-gray-400">
        © {new Date().getFullYear()} {SITE.name} · evespana.es
      </div>
    </footer>
  </body>
</html>
