---
// Hueco de anuncio con altura reservada (evita CLS). Solo se pinta si hay ID de AdSense y "slot".
import { SITE } from '../config/site';
interface Props { slot?: string; minHeight?: number; }
const { slot, minHeight = 280 } = Astro.props;
---
{SITE.adsenseClient && slot && (
  <aside aria-label="Publicidad" class="my-8" style={`min-height:${minHeight}px`}>
    <p class="mb-1 text-xs text-gray-600">Publicidad</p>
    <ins class="adsbygoogle" style="display:block" data-ad-client={SITE.adsenseClient} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
