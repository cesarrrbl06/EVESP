---
import type { CollectionEntry } from 'astro:content';
import { eur, num } from '../lib/format';
interface Props { coche: CollectionEntry<'coches'>; }
const { coche } = Astro.props;
const d = coche.data;
---
<article class="relative flex flex-col overflow-hidden tarjeta-glass p-0 group" data-search={`${d.brand} ${d.title}`.toLowerCase()}>
  <div class="overflow-hidden">
    <img src={d.image} alt={`${d.brand} ${d.title}`} width="640" height="360" loading="lazy" decoding="async" class="aspect-video w-full bg-black/50 object-cover transition-transform duration-500 group-hover:scale-105" />
  </div>
  <div class="flex flex-1 flex-col p-5">
    <p class="text-sm font-semibold text-cyan-400">{d.brand}</p>
    <h3 class="text-lg font-bold text-white">
      <a href={`/coches/${coche.slug}/`} class="after:absolute after:inset-0 hover:glow-text transition-all">{d.title}</a>
    </h3>
    <dl class="mt-4 grid grid-cols-3 gap-2 text-sm border-t border-white/10 pt-4">
      <div><dt class="text-gray-400 text-xs uppercase tracking-wider">Precio</dt><dd class="font-bold tabular-nums text-white mt-1">{eur(d.priceCash).replace(',00', '')}</dd></div>
      <div><dt class="text-gray-400 text-xs uppercase tracking-wider">Auto.</dt><dd class="font-bold tabular-nums text-white mt-1">{num(d.realAutonomyKm)} km</dd></div>
      <div><dt class="text-gray-400 text-xs uppercase tracking-wider">100 km</dt><dd class="font-bold tabular-nums text-green-400 mt-1">{num(d.chargingCostHome, 2)} €</dd></div>
    </dl>
  </div>
</article>
